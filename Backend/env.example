# Google Maps Demo Key — intentionally no billing account.
# Generate it from Google's Maps Demo Key page, then paste it here.
GOOGLE_MAPS_DEMO_KEY=YOUR_GOOGLE_MAPS_DEMO_KEY

# Hugging Face free account token for image editing through Inference Providers.
HF_TOKEN=YOUR_FREE_HUGGING_FACE_TOKEN
HF_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-9B
HF_IMAGE_PROVIDER=auto

# Tripo image-to-3D. Keep this token only in Backend/.env; it is never sent to
# the browser. Create it at https://platform.tripo3d.ai/.
TRIPO_API_KEY=YOUR_TRIPO_API_KEY
MESH_PROVIDER=tripo
TRIPO_MODEL=v3.1-20260211
TRIPO_TEXTURE_QUALITY=detailed
TRIPO_TEXTURE_ALIGNMENT=original_image
TRIPO_GEOMETRY_QUALITY=standard
TRIPO_FACE_LIMIT=50000
# Set to parametric only if a unit-cube demo fallback is desired.
MESH_FALLBACK=none

PORT=3001
